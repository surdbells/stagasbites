{
    "name": "stagasbites/api",
    "description": "Staga's Bites ecommerce API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.8",
        "doctrine/orm": "^3.3",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.9",
        "monolog/monolog": "^3.7",
        "php-di/php-di": "^7.0",
        "php-di/slim-bridge": "^3.4",
        "ramsey/uuid": "^4.7",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "stripe/stripe-php": "^21.0",
        "symfony/cache": "^7.2",
        "symfony/console": "^7.2",
        "symfony/validator": "^7.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "StagasBites\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StagasBites\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse",
        "migrate": "doctrine-migrations migrate --no-interaction",
        "migrate:diff": "doctrine-migrations diff",
        "migrate:status": "doctrine-migrations status",
        "seed": "@php bin/console.php app:seed",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S localhost:8090 -t public public/index.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
